{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NTS Radio Bootleg Media Player",
  "mainBinaryName": "nts-desktop-wmp",
  "version": "../package.json",
  "identifier": "com.datatuna.ntswmp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NTS Radio Bootleg Media Player",
        "width": 234,
        "height": 201,
        "center": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "data-tuna",
    "homepage": "https://github.com/data-tuna/nts-desktop-wmp",
    "copyright": "Copyright (c) 2026 Ata Tuna. Not made or endorsed by NTS.",
    "shortDescription": "Unofficial Windows Media Player-style player for NTS Radio",
    "longDescription": "An unofficial Windows Media Player-style desktop player for NTS Radio. Not made, endorsed or supported by NTS."
  }
}
