{
  "name": "nts-desktop-wmp",
  "private": true,
  "version": "0.0.1",
  "description": "Unofficial Windows Media Player-style desktop player for NTS Radio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:skin",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings src vite.config.ts vite.skin.config.ts",
    "check": "npm run lint && npm run build && npm test",
    "tauri": "tauri",
    "test": "node --test \"tests/*.test.mjs\"",
    "build:skin": "vite build --config vite.skin.config.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3"
  }
}
